# Read by the app itself (Expo inlines EXPO_PUBLIC_* vars at build time).
# Safe to expose client-side — the anon key only grants the public-read
# access already set up by RLS in supabase/migrations/0001_exercise_schema.sql.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Used only by ingestion/ingest.ts (a server-side script — never read by the app).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RAPIDAPI_KEY=

# Phase 3 (monetization) — leave blank until you've created RevenueCat/AdMob
# accounts. Until then, isRevenueCatConfigured/isAdMobConfigured are false and
# the app runs a mock purchase flow / ad placeholders instead (see
# src/services/subscriptions/revenuecat.ts and src/services/ads/adManager.ts).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
